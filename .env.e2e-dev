# Override .env.local when running `npm run dev` against the docker e2e stack.
# Source via `set -a; source .env.e2e-dev; set +a; npm run dev` or use dotenv-cli.

DATABASE_URL=postgres://postgres:postgres@localhost:54329/postgres
DIRECT_URL=postgres://postgres:postgres@localhost:54329/postgres

NEXTAUTH_URL=http://localhost:12000
NEXTAUTH_SECRET=e2e-nextauth-secret-not-prod

# Supabase CLI's API gateway (Kong) on host port 54321 — serves /storage/v1,
# /rest/v1, /auth/v1, etc. directly, so no path-rewriting proxy is needed.
SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# Supabase CLI's fixed local-dev service_role JWT — identical on every default
# `supabase init` project (signed with the CLI's well-known default JWT
# secret), not a real secret. Printed by `supabase start` / `supabase status`.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Backend FastAPI exposed by docker on 8001.
NEXT_PUBLIC_API_URL=http://localhost:8001
CAMPAIGNS_API_URL=http://localhost:8001

# Enables /api/test/login endpoint for fast role switching.
E2E_EXPLORE=1
